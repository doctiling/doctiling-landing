{
  "$comment": "The ONLY repo-specific file of the harness. Hooks and scripts are generic copies of github.com/raalzate/agent-harness (pin 119695d, listed in the workspace repo; byte-identical across the doctiling repos). Key reference: docs/config-reference.md in agent-harness. Ported 2026-10-12. Host-agnostic marketing package consumed by doctiling-web; @doctiling/ui is a peer resolved through the .ui symlink.",
  "gate": {
    "command": "npm run gate",
    "fastCommand": "npm run gate",
    "marker": ".git/gate-dirty",
    "codeGlobs": [
      "src/",
      "tests/",
      "scripts/",
      ".claude/hooks/",
      ".githooks/",
      ".github/workflows/"
    ],
    "codeExtensions": [
      ".ts",
      ".tsx",
      ".mjs",
      ".js",
      ".json",
      ".yml"
    ],
    "installHooksCommand": "npm run hooks:install",
    "signals": [
      {
        "name": "harness self-test",
        "command": [
          "node",
          "scripts/harness-selftest.mjs"
        ],
        "why": "a broken hook, a rule that no longer bites or a config pointing at nothing fail silently"
      },
      {
        "name": "docs link-check",
        "command": [
          "node",
          "scripts/docs-linkcheck.mjs"
        ],
        "why": "a doc pointer to a moved file sends the agent to read nothing"
      },
      {
        "name": "convention lint",
        "command": [
          "node",
          "scripts/repo-lint.mjs"
        ],
        "why": "the rules of this repo that no compiler sees (a forgotten .only, CI without the gate, a product import in the landing), with a command that fails"
      },
      {
        "name": "harness cost (hook latency)",
        "command": [
          "node",
          "scripts/hooks-timing.mjs"
        ],
        "why": "a slow hook is paid on EVERY edit and prompt; the budget turns «this will be slow» into a failing command"
      },
      {
        "name": "link @doctiling/ui",
        "command": [
          "node",
          "scripts/link-ui.mjs"
        ],
        "why": "the design system is a peer from another checkout; without the link, typecheck and tests resolve nothing"
      },
      {
        "name": "white-label guard",
        "command": [
          "node",
          "scripts/white-label-guard.mjs",
          "--all"
        ],
        "why": "a vendor name in marketing copy compiles and passes tests; only this guard knows the scoped exceptions (P4)"
      },
      {
        "name": "typecheck",
        "command": [
          "npm",
          "run",
          "typecheck"
        ],
        "why": "vitest transpiles per file and never type-checks; an invalid import or a host-contract break passes the tests"
      },
      {
        "name": "tests",
        "command": [
          "npm",
          "test"
        ],
        "why": "behaviour of every section and page against a fake host; the only check of the host contract from this side (P3, P5)"
      }
    ]
  },
  "protectedPaths": [
    {
      "pattern": "(^|/)\\.env(\\.|$)",
      "reason": "public repo: no .env ever, and the agent never edits one."
    },
    {
      "pattern": "(^|/)package-lock\\.json$",
      "reason": "package-lock.json is regenerated by npm, never edited by hand.",
      "agentOnly": true
    },
    {
      "pattern": "^\\.git/",
      "reason": "git history is not edited file by file."
    },
    {
      "pattern": "^\\.ui(/|$)",
      "reason": "`.ui` is a symlink to the sibling web checkout's design system: edit atoms in doctiling-web, never through the link."
    },
    {
      "pattern": "^\\.codegraph/",
      "reason": "the codegraph index is derived: rebuild it with `codegraph init`/`sync`."
    }
  ],
  "bash": {
    "deny": [
      {
        "pattern": "--no-ver[i]fy",
        "reason": "skipping the verification hooks is forbidden. If the gate is in the way, fix the gate."
      },
      {
        "pattern": "git\\s+push\\s+.*--for[c]e(?!-with-lease)",
        "reason": "rewrites remote history. Use --force-with-lease and ask first."
      },
      {
        "pattern": "git\\s+reset\\s+--har[d]",
        "reason": "destroys uncommitted work. Use `git stash` or ask first."
      },
      {
        "pattern": "git\\s+clean\\s+-[a-z]*f",
        "reason": "deletes untracked files. Dry-run first: `git clean -n`."
      },
      {
        "pattern": "git\\s+add\\s+(\\.|-A|--all)(\\s|$)",
        "reason": "`git add .` sweeps local state. Stage specific files."
      },
      {
        "pattern": "\\brm\\s+-rf?\\s+[^|;&\\n]*\\b(src|tests|scripts)/",
        "reason": "recursive delete of source directories: show the list and ask for confirmation first."
      },
      {
        "pattern": "\\bfind\\b[^|;&]*-delete",
        "reason": "`find -delete` deletes without showing. Run the find without -delete and confirm the list."
      },
      {
        "pattern": "\\bcurl\\b[^|;&]*\\|\\s*(ba)?sh",
        "reason": "`curl | sh` runs remote code unread. Download the script, read it, then run it."
      }
    ],
    "ask": [
      {
        "pattern": "git\\s+push\\s+.*--force-with-lease",
        "reason": "rewrites remote history (with a safety net). Is the branch yours alone?"
      },
      {
        "pattern": "git\\s+branch\\s+(-D|--delete\\s+--force)\\b",
        "reason": "deletes the branch even if unmerged."
      },
      {
        "pattern": "\\bgit\\s+tag\\b",
        "reason": "a tag is a release the host pins (P7); confirm the version and the green gate first."
      }
    ]
  },
  "reuse": [
    {
      "pattern": "href=\\s*[\"']/(?!(en|es)/landing[\"'])",
      "appliesTo": "^src/",
      "reason": "a hard-coded product route in the landing: routes go through href() of the host contract (src/host.tsx, src/routes.ts) so the SaaS host can mount the package under any base path (P3). The locale switch links (/en/landing, /es/landing) are the one allowed literal.",
      "see": "src/routes.ts"
    }
  ],
  "lint": {
    "command": [
      "node",
      "scripts/repo-lint.mjs"
    ],
    "fileFlag": "--file",
    "sourceExtensions": [
      ".ts",
      ".tsx",
      ".mjs",
      ".js",
      ".json",
      ".yml"
    ]
  },
  "preCommit": {
    "extra": []
  },
  "purity": [
    {
      "dir": ".claude/hooks",
      "forbiddenImports": [
        "node:child_process",
        "child_process"
      ],
      "except": [
        ".claude/hooks/post-edit-check.mjs",
        ".claude/hooks/session-start.mjs"
      ],
      "reason": "a hook that spawns processes costs latency on EVERY edit or prompt; the two exceptions are declared upstream (agent-harness)."
    },
    {
      "dir": "src",
      "forbiddenImports": [
        "next/",
        "next",
        "@/"
      ],
      "except": [
        "src/seo.ts"
      ],
      "reason": "host-agnostic: the landing never imports the product nor Next at runtime (P3); everything arrives through the host contract. The one exception is the type-only `Metadata` import in src/seo.ts (the host's type for the page metadata it asks this package for)."
    }
  ],
  "purityImportSyntax": [
    "from\\s+['\"]{mod}['\"]",
    "require\\(\\s*['\"]{mod}['\"]",
    "import\\s+['\"]{mod}['\"]"
  ],
  "forbiddenDeps": {
    "manifest": "package.json",
    "packages": [],
    "reason": "nothing vetoed: `next` and `react` are peers (the host brings the framework, P3); a runtime dependency on either would be the violation and is caught by the purity rule on src/."
  },
  "singleSource": [],
  "invariants": [
    {
      "file": ".github/workflows/gate.yml",
      "required": [
        "npm run gate"
      ],
      "forbidden": [
        "continue-on-error: true"
      ],
      "reason": "CI verifies THE SAME deliverable as the human and the agent (P1)."
    }
  ],
  "patterns": [],
  "tests": {
    "filePattern": "(^|/)(__tests__|tests?)/|\\.(test|spec)\\.[cm]?[jt]sx?$",
    "onlyPattern": "\\b(describe|it|test)\\.only\\("
  },
  "incidents": {
    "file": "docs/gotchas.md",
    "heading": "### GOTCHA",
    "requiredLines": [
      "Síntoma:",
      "Causa:",
      "Regla:",
      "Mecanismo:"
    ]
  },
  "docs": {
    "proseRoots": [
      "docs",
      "scripts",
      ".claude",
      ".github",
      ".githooks"
    ],
    "ignore": [
      "node_modules",
      ".git",
      "coverage",
      ".ui"
    ],
    "ignoreFiles": [
      "docs/buenas-practicas.md",
      "docs/sdd.md",
      "docs/trazabilidad.md",
      "docs/codegraph.md",
      "docs/cicd.md",
      "docs/arquitectura.md",
      "docs/agilidad.md",
      "docs/ciclo-desarrollo.md",
      "docs/multi-proyecto.md",
      "docs/multiplataforma.md",
      "docs/panel.md"
    ],
    "externalPaths": [],
    "mentionSignals": [
      "docs/agent-harness.md"
    ],
    "ignoreMarker": "linkcheck:ignore"
  },
  "status": {
    "file": "STATUS.md",
    "reminder": "Nothing ships without `npm run gate` green · every change ships as a new tag and the host pins tags (P7) · both locales, same keys (P5)."
  },
  "tracker": {
    "kind": "github",
    "issuePattern": "(^|[^A-Za-z0-9_])#[0-9]+",
    "issueExample": "#5 · Refs #5 · Closes #5",
    "newIssueHint": [
      "gh issue create --repo doctiling/doctiling-landing --title \"…\" --body \"…\""
    ],
    "artifactsIn": "repo",
    "specsDir": "specs",
    "allowedInRepo": []
  },
  "commitMsg": {
    "$comment": "Same policy as the workspace (owner decision 2026-10-12): a commit touching code references a GitHub item (#N) or carries `no-issue: <motivo>`.",
    "codePattern": "^(src/|tests/|scripts/|\\.claude/|\\.githooks/|\\.github/|package\\.json$|tsconfig\\.json$|vitest\\.config\\.ts$)",
    "ignoreExtensions": [
      ".md",
      ".png",
      ".jpg",
      ".jpeg",
      ".svg",
      ".webp",
      ".ico"
    ],
    "skipSubjects": [
      "Merge ",
      "Revert ",
      "fixup! ",
      "squash! "
    ],
    "escapeLine": "no-issue:"
  },
  "branches": {
    "protected": [
      "main"
    ],
    "reason": "work enters main by pull request with a green gate; every tag is cut from main."
  },
  "workflow": {
    "model": "github-flow",
    "branchPattern": "^(feat|fix|docs|chore|refactor|test|ci|perf|release)/[a-z0-9][a-z0-9._-]*$",
    "branchExamples": [
      "chore/harness-119695d",
      "feat/verticals-page"
    ],
    "longLived": [
      "main"
    ],
    "baseBranch": "main",
    "mergeInto": [
      {
        "branch": ".*",
        "into": [
          "main"
        ]
      }
    ],
    "maxAgeDays": 7,
    "staleAction": "warn",
    "reason": "one short branch per change, named type/what.",
    "staleReason": "a branch not integrated for days is a big batch waiting."
  },
  "xp": {
    "testFirst": {
      "enabled": false,
      "testPattern": "(^|/)(__tests__|tests?)/|\\.(test|spec)\\.[cm]?[jt]sx?$",
      "escapeLine": "no-test:",
      "reason": ""
    },
    "smallBatch": {
      "enabled": false,
      "maxFiles": 30,
      "maxLines": 900,
      "escapeLine": "big-batch:",
      "reason": ""
    },
    "refactorSeparate": {
      "enabled": false,
      "subjectPattern": "^refactor(\\(|:)",
      "escapeLine": "mixed-refactor:",
      "reason": ""
    },
    "pairing": {
      "enabled": false,
      "trailer": "Co-authored-by:",
      "escapeLine": "solo:",
      "reason": ""
    }
  },
  "sdd": {
    "kit": "ninguno",
    "skillRoots": [],
    "phases": [],
    "specsDir": "specs",
    "activeFeaturePointer": "",
    "routes": [
      {
        "route": "copy",
        "patterns": [
          "\\b(copy|texto|textos|i18n|traducci[oó]n|locale|idioma)\\b"
        ],
        "message": "Copy lives in src/i18n/{en,es}.json, both locales in the same change (P5); vendor names never reach copy (white-label guard, P4)."
      },
      {
        "route": "host",
        "patterns": [
          "\\b(host|LandingHostProvider|href\\(|producto|product|next\\b|@/)"
        ],
        "message": "Host-agnostic (P3): the landing never imports the product or Next; everything arrives through the host contract in src/host.tsx. Tests render with tests/helpers/host.tsx."
      },
      {
        "route": "harness",
        "patterns": [
          "\\bhook\\b",
          "\\bgate\\b",
          "\\barn[ée]s\\b",
          "\\bharness\\b"
        ],
        "message": "Harness change → specifics go in `.claude/harness.config.json`; the generic files come from agent-harness and change in EVERY doctiling repo in the same change (workspace `node scripts/harness-drift.mjs`)."
      },
      {
        "route": "none",
        "patterns": [
          "\\btypo\\b",
          "\\bexpl[ií]came\\b",
          "\\bqu[ée] hace\\b"
        ],
        "message": ""
      }
    ]
  },
  "askFirst": {
    "marker": ".git/agent-answer-first",
    "questionPatterns": [
      "^\\s*¿",
      "\\?\\s*$",
      "^\\s*(qu[eé]|por\\s?qu[eé]|c[oó]mo|cu[aá]l(es)?|cu[aá]ndo|d[oó]nde|qui[eé]n|para\\s?qu[eé])(?=\\s|$|[,:])",
      "^\\s*(hay|existe|sirve|conviene|se puede|pod[eé]s|sab[eé]s|vale la pena)(?=\\s|$|[,:])"
    ],
    "actionPatterns": [
      "\\b(arregl|corrig|implement|agreg|a[ñn]ad|cambi|escrib|cre[aá]|aplic|instal|port|actualiz|borr|elimin|quit|refactor|migr|public|commit|push|generá|genera|hacelo|haz|dale|proced|ajust)"
    ],
    "pastPatterns": [
      "\\b\\w+(aste|iste|aron|ieron|abas|amos|imos)(?=\\s|$|[,.?!])",
      "\\b\\w+(ó|ió)(?=\\s|$|[,.?!])",
      "\\b(hab[ií]as|hiciste|dejaste|qued[oó])(?=\\s|$|[,.?!])"
    ],
    "strongQuestionPatterns": [
      "^\\s*¿",
      "^\\s*(qu[eé]|por\\s?qu[eé]|c[oó]mo|cu[aá]l(es)?|cu[aá]ndo|d[oó]nde|qui[eé]n|para\\s?qu[eé])(?=\\s|$|[,:])"
    ],
    "directRequestPatterns": [
      "\\b(pod[eé]s|puedes|podr[ií]as|te pido|por favor|necesito que|quiero que)\\b"
    ],
    "message": "Esto es una **pregunta**: contestala con lo que ya sabés o leyendo lo que haga falta. **No edites archivos del repo**: el hook `action-guard` los va a bloquear hasta el próximo pedido del humano."
  },
  "graph": {
    "tool": "codegraph",
    "graphFile": ".codegraph/codegraph.db",
    "queryCommand": "codegraph explore \"<pregunta>\"",
    "panoramaCommand": "codegraph ui",
    "statusCommand": "codegraph status",
    "installHint": "curl -fsSL -o /tmp/codegraph-install.sh https://raw.githubusercontent.com/colbymchenry/codegraph/main/install.sh  →  read it  →  sh /tmp/codegraph-install.sh  →  codegraph install  →  codegraph init",
    "questionPatterns": [
      "\\bqui[eé]n (llama|usa|importa|depende)",
      "\\bradio de impacto\\b",
      "\\bdependencia circular\\b"
    ]
  },
  "subagentOutput": {
    "contracts": {
      "reviewer": {
        "mustMatch": "VEREDICTO:\\W*(rechazado|aprobado)",
        "reason": "the main agent decides whether to ship on that line; without it, the review is an opinion."
      },
      "gate-runner": {
        "mustMatch": "VEREDICTO:\\W*(VERDE|ROJO)",
        "reason": "«nothing ships without a green gate» (P1) is decided on that line, not on a summary."
      }
    }
  },
  "observability": {
    "budgetMs": 400,
    "runs": 3,
    "budgets": {
      ".claude/hooks/post-edit-check.mjs": 900,
      ".claude/hooks/session-start.mjs": 900
    },
    "probe": {
      "filePath": "src/host.tsx",
      "command": "git status",
      "prompt": "¿cómo está el arnés?"
    },
    "reason": "a slow hook is paid on EVERY turn; the budget turns «this will be slow» into a failing command.",
    "stateFiles": [
      ".git/gate-dirty",
      ".git/agent-answer-first"
    ]
  },
  "drift": {
    "statusDatePattern": "Last full gate:\\W*(\\d{4}-\\d{2}-\\d{2})",
    "statusMaxAgeDays": 14,
    "historyCommits": 400,
    "runner": ".github/workflows/drift.yml"
  },
  "coherence": {
    "guides": [
      "CLAUDE.md",
      "docs/agent-harness.md",
      ".claude/commands",
      ".claude/agents"
    ],
    "commandPattern": "^(git|node|sh|gh|npm|npx|codegraph|find|curl|rm)\\s",
    "configKeys": [
      "reason",
      "message",
      "staleReason"
    ],
    "reason": "a guide recommending what a guard forbids leaves the agent in a retry loop."
  },
  "panel": {
    "out": ".git/harness-panel",
    "sources": {
      "guide": "CLAUDE.md",
      "constitutions": [
        "CONSTITUTION.md"
      ],
      "mechanismMarker": "*Mechanism:*"
    },
    "memory": {
      "decisionsDir": "docs/decisions",
      "runSessionHooks": true,
      "promptSources": [
        {
          "hook": "sdd-router",
          "key": "sdd.routes"
        }
      ]
    }
  },
  "taxonomy": {
    "stages": [
      "sesión",
      "pedido",
      "acción decidida",
      "edición hecha",
      "fin del turno",
      "commit",
      "push",
      "integración",
      "continuo"
    ],
    "events": {
      "SessionStart": {
        "direction": "guía",
        "stage": "sesión"
      },
      "UserPromptSubmit": {
        "direction": "guía",
        "stage": "pedido"
      },
      "PreToolUse": {
        "direction": "freno",
        "stage": "acción decidida"
      },
      "PostToolUse": {
        "direction": "sensor",
        "stage": "edición hecha"
      },
      "Stop": {
        "direction": "sensor",
        "stage": "fin del turno"
      },
      "SubagentStop": {
        "direction": "sensor",
        "stage": "fin del turno"
      }
    },
    "gitHooksDir": ".githooks",
    "gitHooks": {
      "pre-commit": {
        "direction": "sensor",
        "stage": "commit"
      },
      "commit-msg": {
        "direction": "sensor",
        "stage": "commit"
      },
      "post-commit": {
        "direction": "guía",
        "stage": "commit"
      },
      "pre-push": {
        "direction": "sensor",
        "stage": "push"
      }
    },
    "gateStages": [
      "fin del turno",
      "integración"
    ],
    "agents": {
      "explorer": {
        "direction": "guía",
        "kind": "inferencial",
        "stage": "pedido"
      },
      "reviewer": {
        "direction": "sensor",
        "kind": "inferencial",
        "stage": "fin del turno"
      },
      "gate-runner": {
        "direction": "sensor",
        "kind": "computacional",
        "stage": "fin del turno"
      }
    },
    "guides": {
      "CLAUDE.md": {
        "stage": "sesión"
      },
      "CONSTITUTION.md": {
        "stage": "sesión"
      },
      ".claude/commands": {
        "stage": "pedido"
      },
      ".claude/skills": {
        "stage": "pedido"
      }
    },
    "pipelines": {
      ".github/workflows/gate.yml": {
        "stage": "integración"
      },
      ".github/workflows/drift.yml": {
        "stage": "continuo"
      }
    }
  },
  "install": {
    "activators": {
      ".claude/hooks/protected-paths.mjs": "protectedPaths",
      ".claude/hooks/bash-guard.mjs": "bash.deny",
      ".claude/hooks/reuse-guard.mjs": "reuse",
      ".claude/hooks/post-edit-check.mjs": "lint.command",
      ".claude/hooks/gate-stop.mjs": "gate.marker",
      ".claude/hooks/subagent-contract.mjs": "subagentOutput.contracts",
      ".claude/hooks/session-start.mjs": "status.file",
      ".claude/hooks/sdd-router.mjs": "sdd.routes",
      ".claude/hooks/graph-first.mjs": "graph.graphFile",
      ".claude/hooks/ask-first.mjs": "askFirst.marker",
      ".claude/hooks/action-guard.mjs": "askFirst.marker",
      ".githooks/commit-msg": "commitMsg.codePattern",
      ".githooks/pre-push": "branches.protected",
      "scripts/cycle-check.mjs": "workflow.branchPattern",
      "scripts/hooks-timing.mjs": "observability.budgetMs",
      "scripts/harness-map.mjs": "taxonomy",
      "scripts/drift-check.mjs": "drift"
    }
  }
}
