{
  "$comment": "The ONLY repo-specific file of the harness. Hooks and scripts are generic copies of github.com/raalzate/agent-harness, byte-identical across the doctiling repos (doctiling-workspace scripts/harness-files.txt + `node scripts/harness-drift.mjs`). Key reference: docs/config-reference.md in agent-harness. This repo: docs/arnes.md.",
  "gate": {
    "command": "npm run gate",
    "fastCommand": "npm run gate:fast",
    "marker": ".git/gate-dirty",
    "codeGlobs": [
      "src/",
      "tests/",
      "scripts/",
      ".claude/hooks/",
      ".githooks/"
    ],
    "codeExtensions": [
      ".ts",
      ".tsx",
      ".mjs",
      ".js"
    ],
    "installHooksCommand": "npm run hooks:install",
    "signals": [
      {
        "name": "harness self-test",
        "command": [
          "node",
          "scripts/harness-selftest.mjs"
        ],
        "why": "a broken hook, a rule that no longer bites or a config key pointing at nothing fail silently"
      },
      {
        "name": "docs link-check",
        "command": [
          "node",
          "scripts/docs-linkcheck.mjs"
        ],
        "why": "a doc pointer to a moved file sends the agent to read nothing"
      },
      {
        "name": "convention lint",
        "command": [
          "node",
          "scripts/repo-lint.mjs"
        ],
        "why": "the rules of this repo that no compiler sees, with a command that fails"
      },
      {
        "name": "artifacts in place",
        "command": [
          "node",
          "scripts/artifacts-check.mjs"
        ],
        "why": "specs live in doctiling-web (the host); a plan loose here splits the record in two"
      },
      {
        "name": "link @doctiling/ui",
        "command": [
          "npm",
          "run",
          "link:ui"
        ],
        "why": "the design system is a peer from another checkout; without the link, typecheck and tests resolve nothing"
      },
      {
        "name": "white-label guard",
        "command": [
          "node",
          "scripts/white-label-guard.mjs",
          "--all"
        ],
        "why": "a vendor name in marketing copy compiles and passes tests; only this guard knows the scoped exceptions"
      },
      {
        "name": "typecheck",
        "command": [
          "npm",
          "run",
          "typecheck"
        ],
        "why": "vitest transpiles per file and never type-checks; an invalid import or a host-contract break passes the tests"
      },
      {
        "name": "tests",
        "command": [
          "npm",
          "test"
        ],
        "why": "behaviour of every section and page against a fake host; the only check of the host contract from this side"
      },
      {
        "name": "code index (codegraph)",
        "command": [
          "codegraph",
          "status"
        ],
        "skipIfMissing": ".codegraph",
        "why": "a stale index lies worse than none; OMITTED until someone runs `codegraph init` — omitted is not green"
      },
      {
        "name": "harness cost (hook latency)",
        "command": [
          "node",
          "scripts/hooks-timing.mjs"
        ],
        "why": "no other signal measures what the harness costs per prompt and per edit, and an expensive harness gets disabled whole"
      }
    ]
  },
  "protectedPaths": [
    {
      "pattern": "(^|/)\\.env(\\.|$)",
      "reason": ".env files are never edited by the agent (this repo is public: nothing secret belongs here at all)."
    },
    {
      "pattern": "(^|/)package-lock\\.json$",
      "agentOnly": true,
      "reason": "package-lock.json is regenerated with `npx -y npm@10.8.2 install`, never edited by hand."
    },
    {
      "pattern": "^\\.git/",
      "reason": "git history is not edited file by file."
    },
    {
      "pattern": "^node_modules/",
      "reason": "dependencies change through package.json + install."
    },
    {
      "pattern": "^\\.ui/",
      "reason": "`.ui` is a symlink into the doctiling-web checkout (scripts/link-ui.sh): the design system is changed in doctiling-web, never copied or edited from here."
    },
    {
      "pattern": "^\\.codegraph/",
      "reason": "the codegraph index is derived: rebuild it with `codegraph init`/`sync`."
    }
  ],
  "bash": {
    "deny": [
      {
        "pattern": "--no-ver[i]fy",
        "reason": "skipping the verification hooks is forbidden. If the gate is in the way, fix the gate."
      },
      {
        "pattern": "git\\s+push\\s+.*--force(?!-with-lease)",
        "reason": "`--force` rewrites remote history. Use --force-with-lease and ask first."
      },
      {
        "pattern": "git\\s+reset\\s+--hard",
        "reason": "`reset --hard` destroys uncommitted work. Use `git stash` or ask first."
      },
      {
        "pattern": "git\\s+clean\\s+-[a-z]*f",
        "reason": "deletes untracked files. Dry-run first: `git clean -n`."
      },
      {
        "pattern": "git\\s+add\\s+(\\.|-A|--all)(\\s|$)",
        "reason": "`git add .` sweeps local state. Stage specific files."
      },
      {
        "pattern": "\\bfind\\b[^|;&]*-delete",
        "reason": "`find -delete` deletes without showing. Run the find without -delete and confirm the list."
      },
      {
        "pattern": "\\bcurl\\b[^|;&]*\\|\\s*(ba)?sh",
        "reason": "`curl | sh` runs remote code unread. Download the script, read it, then run it."
      }
    ],
    "ask": [
      {
        "pattern": "git\\s+push\\s+.*--force-with-lease",
        "reason": "rewrites remote history (with a safety net). Is the branch yours alone?"
      },
      {
        "pattern": "git\\s+branch\\s+(-D|--delete\\s+--force)\\b",
        "reason": "deletes the branch even if unmerged."
      }
    ]
  },
  "reuse": [
    {
      "pattern": "<LandingHostProvider\\b",
      "appliesTo": "^tests/(?!helpers/|host\\.test\\.tsx$)",
      "reason": "tests render through `renderWithHost` (fake host + `t` that echoes the key); a hand-mounted provider drifts from the fake host every other test uses.",
      "see": "tests/helpers/host.tsx"
    }
  ],
  "lint": {
    "command": [
      "node",
      "scripts/repo-lint.mjs"
    ],
    "fileFlag": "--file"
  },
  "purity": [
    {
      "dir": ".claude/hooks",
      "forbiddenImports": [
        "node:child_process",
        "child_process"
      ],
      "except": [
        ".claude/hooks/post-edit-check.mjs",
        ".claude/hooks/session-start.mjs"
      ],
      "reason": "a hook that spawns processes costs latency on EVERY edit or prompt; the two exceptions are declared upstream (agent-harness)."
    }
  ],
  "purityImportSyntax": [
    "from\\s+['\"]{mod}['\"]",
    "require\\(\\s*['\"]{mod}['\"]",
    "import\\s+['\"]{mod}['\"]"
  ],
  "singleSource": [],
  "invariants": [
    {
      "file": ".github/workflows/ci.yml",
      "required": [
        "npm run gate"
      ],
      "forbidden": [
        "continue-on-error: true"
      ],
      "reason": "CI verifies THE SAME deliverable as the human and the agent (P1), on every push, PR and v* tag."
    },
    {
      "file": ".githooks/pre-commit",
      "required": [
        "harness.config.json"
      ],
      "forbidden": [
        "--config"
      ],
      "reason": "the pre-commit checks THIS repo config, never a permissive alternative."
    }
  ],
  "patterns": [
    {
      "id": "HOST-IMPORT",
      "pattern": "from\\s+[\"']@/",
      "appliesTo": "^(src|tests)/.*\\.tsx?$",
      "message": "the landing never imports product code (P3): what it needs from the host crosses `LandingHost` (src/host.tsx)."
    }
  ],
  "tests": {
    "filePattern": "(^|/)(__tests__|tests?)/|\\.(test|spec)\\.[cm]?[jt]sx?$",
    "onlyPattern": "\\b(describe|it|test)\\.only\\("
  },
  "incidents": {
    "file": "docs/gotchas.md",
    "heading": "### GOTCHA",
    "requiredLines": [
      "Síntoma:",
      "Causa:",
      "Regla:",
      "Mecanismo:"
    ]
  },
  "docs": {
    "proseRoots": [
      "docs",
      "scripts",
      ".claude",
      ".github",
      ".githooks"
    ],
    "ignore": [
      "node_modules",
      ".git",
      "coverage",
      ".ui",
      ".next",
      "web"
    ],
    "ignoreFiles": [
      "docs/buenas-practicas.md"
    ],
    "externalPaths": [],
    "mentionSignals": [
      "docs/arnes.md"
    ],
    "ignoreMarker": "linkcheck:ignore",
    "$commentWeb": "`web/` is the sparse checkout of doctiling-web that CI makes for @doctiling/ui (DOCTILING_UI_DIR); gitignored, never this repo's prose."
  },
  "status": {
    "file": "STATUS.md",
    "reminder": "Nothing ships without `npm run gate` green · every change ships as a new tag (the host pins tags) · lessons via `/lesson`."
  },
  "askFirst": {
    "marker": ".git/agent-answer-first",
    "questionPatterns": [
      "^\\s*¿",
      "\\?\\s*$",
      "^\\s*(qu[eé]|por\\s?qu[eé]|c[oó]mo|cu[aá]l(es)?|cu[aá]ndo|d[oó]nde|qui[eé]n|para\\s?qu[eé])(?=\\s|$|[,:])",
      "^\\s*(hay|existe|sirve|conviene|se puede|pod[eé]s|sab[eé]s|vale la pena)(?=\\s|$|[,:])"
    ],
    "actionPatterns": [
      "\\b(arregl|corrig|implement|agreg|a[ñn]ad|cambi|escrib|cre[aá]|aplic|instal|port|actualiz|borr|elimin|quit|refactor|migr|public|commit|push|generá|genera|hacelo|haz|dale|proced|ajust)"
    ],
    "message": "Esto es una **pregunta**: contestala con lo que ya sabés o leyendo lo que haga falta. **No edites archivos del repo**: el hook `action-guard` los va a bloquear hasta el próximo pedido del humano.",
    "pastPatterns": [
      "\\b\\w+(aste|iste|aron|ieron|abas|amos|imos)(?=\\s|$|[,.?!])",
      "\\b\\w+(ó|ió)(?=\\s|$|[,.?!])",
      "\\b(hab[ií]as|hiciste|dejaste|qued[oó])(?=\\s|$|[,.?!])"
    ],
    "strongQuestionPatterns": [
      "^\\s*¿",
      "^\\s*(qu[eé]|por\\s?qu[eé]|c[oó]mo|cu[aá]l(es)?|cu[aá]ndo|d[oó]nde|qui[eé]n|para\\s?qu[eé])(?=\\s|$|[,:])"
    ],
    "directRequestPatterns": [
      "\\b(pod[eé]s|puedes|podr[ií]as|te pido|por favor|necesito que|quiero que)\\b"
    ]
  },
  "branches": {
    "protected": [
      "main"
    ],
    "reason": "work enters main by pull request with a green gate (every merge in the history is `Merge pull request #N`)."
  },
  "sdd": {
    "kit": "sofka",
    "skillRoots": [
      "~/.claude/skills",
      ".claude/skills"
    ],
    "phases": [],
    "specsDir": "specs",
    "activeFeaturePointer": "",
    "routes": [
      {
        "route": "sdd",
        "patterns": [
          "\\bnueva (feature|funcionalidad|pantalla|p[aá]gina)\\b",
          "\\bspec \\d{3}\\b"
        ],
        "message": "Feature-sized request → the spec lives in doctiling-web (specs/NNN-*), the host that mounts this package; here only the package changes, with its tests."
      },
      {
        "route": "cicd",
        "patterns": [
          "\\bpipeline\\b",
          "\\bci/?cd\\b",
          "\\bworkflow\\b",
          "\\brelease\\b",
          "\\btag\\b"
        ],
        "message": "Touches the pipeline: CI runs THE SAME `npm run gate`, on every push, PR and v* tag; a red tag never reaches the host."
      },
      {
        "route": "harness",
        "patterns": [
          "\\bhook\\b",
          "\\bgate\\b",
          "\\barn[ée]s\\b",
          "\\bharness\\b"
        ],
        "message": "Harness change → specifics go in `.claude/harness.config.json`. Generic files come from agent-harness upstream and change in EVERY doctiling repo in the same change (doctiling-workspace `node scripts/harness-drift.mjs`)."
      },
      {
        "route": "none",
        "patterns": [
          "\\btypo\\b",
          "\\bexplicame\\b",
          "\\bqu[ée] hace\\b"
        ],
        "message": ""
      }
    ]
  },
  "tracker": {
    "kind": "github",
    "issuePattern": "(^|[^A-Za-z0-9_])#[0-9]+",
    "issueExample": "#123 · Refs #123 · Closes #123",
    "newIssueHint": [
      "gh issue create --repo doctiling/doctiling-landing --title \"…\" --body \"…\""
    ],
    "artifactsIn": "tracker",
    "specsDir": "specs",
    "allowedInRepo": []
  },
  "commitMsg": {
    "codePattern": "^(src/|tests/|scripts/|\\.claude/|\\.githooks/|\\.github/)",
    "ignoreExtensions": [
      ".md",
      ".png",
      ".jpg",
      ".jpeg",
      ".svg",
      ".html"
    ],
    "skipSubjects": [
      "Merge ",
      "Revert ",
      "fixup! ",
      "squash! "
    ],
    "escapeLine": "no-issue:"
  },
  "workflow": {
    "model": "github-flow",
    "branchPattern": "^(feat|fix|docs|chore|refactor|test|ci|perf)/[a-z0-9][a-z0-9._-]*$",
    "branchExamples": [
      "feat/verticals-page",
      "fix/seo-canonical"
    ],
    "longLived": [
      "main"
    ],
    "baseBranch": "main",
    "mergeInto": [
      {
        "branch": ".*",
        "into": [
          "main"
        ]
      }
    ],
    "maxAgeDays": 5,
    "staleAction": "warn",
    "reason": "one short branch per change, named type/what — the convention the history already follows.",
    "staleReason": "a branch not integrated for days is a big batch waiting."
  },
  "xp": {
    "testFirst": {
      "enabled": false,
      "testPattern": "(^|/)(__tests__|tests?)/|\\.(test|spec)\\.[cm]?[jt]sx?$",
      "escapeLine": "no-test:",
      "reason": ""
    },
    "smallBatch": {
      "enabled": false,
      "maxFiles": 30,
      "maxLines": 900,
      "escapeLine": "big-batch:",
      "reason": ""
    },
    "refactorSeparate": {
      "enabled": false,
      "subjectPattern": "^refactor(\\(|:)",
      "escapeLine": "mixed-refactor:",
      "reason": ""
    },
    "pairing": {
      "enabled": false,
      "trailer": "Co-authored-by:",
      "escapeLine": "solo:",
      "reason": ""
    }
  },
  "graph": {
    "tool": "codegraph",
    "graphFile": ".codegraph/codegraph.db",
    "queryCommand": "codegraph explore \"<pregunta>\"",
    "panoramaCommand": "codegraph ui",
    "statusCommand": "codegraph status",
    "installHint": "curl -fsSL -o /tmp/codegraph-install.sh https://raw.githubusercontent.com/colbymchenry/codegraph/main/install.sh  →  read it  →  sh /tmp/codegraph-install.sh  →  codegraph install  →  codegraph init",
    "questionPatterns": [
      "\\bqui[eé]n (llama|usa|importa|depende)",
      "\\bradio de impacto\\b",
      "\\bdependencia circular\\b"
    ]
  },
  "observability": {
    "budgetMs": 400,
    "runs": 3,
    "budgets": {
      ".claude/hooks/post-edit-check.mjs": 900,
      ".claude/hooks/session-start.mjs": 900
    },
    "probe": {
      "filePath": "src/host.tsx",
      "command": "git status",
      "prompt": "¿cómo está el arnés?"
    },
    "reason": "a slow hook is paid on EVERY turn; the budget turns «this will be slow» into a failing command.",
    "stateFiles": [
      ".git/gate-dirty",
      ".git/agent-answer-first"
    ]
  },
  "subagentOutput": {
    "contracts": {
      "reviewer": {
        "mustMatch": "VEREDICTO:\\W*(rechazado|aprobado)",
        "reason": "the main agent decides whether to ship on that line; without it, the review is an opinion."
      },
      "gate-runner": {
        "mustMatch": "VEREDICTO:\\W*(VERDE|ROJO)",
        "reason": "«nothing ships without a green gate» (P1) is decided on that line, not on a summary."
      },
      "ci-investigator": {
        "mustMatch": "VEREDICTO:\\W*(ROJO|VERDE|OMITIDO|EN CURSO)",
        "reason": "el agente principal decide si CI bloquea el merge con esa línea; sin ella, «CI anda raro» es una opinión, y OMITIDO tiene que decirse: no es verde."
      }
    }
  },
  "ci": {
    "investigate": {
      "$comment": "Read the remote pipeline failure (docs/cicd.md): `scripts/ci-investigate.mjs`, run by the `ci-investigator` subagent and `/ci`. Same values as agent-harness upstream; `--workflow ci.yml` keeps other workflows from hiding the gate. No CLI or credentials = OMITTED, and omitted is not green.",
      "listCommand": [
        "gh",
        "run",
        "list",
        "--workflow",
        "ci.yml",
        "--branch",
        "{branch}",
        "--limit",
        "1",
        "--json",
        "databaseId,status,conclusion,name,url"
      ],
      "idField": "databaseId",
      "conclusionField": "conclusion",
      "nameField": "name",
      "urlField": "url",
      "failedValues": [
        "failure",
        "timed_out",
        "startup_failure"
      ],
      "passedValues": [
        "success"
      ],
      "logCommand": [
        "gh",
        "run",
        "view",
        "{run}",
        "--log-failed"
      ],
      "logFields": [
        "job",
        "paso"
      ],
      "stripPattern": "^\\d{4}-\\d{2}-\\d{2}T[\\d:.]+Z\\s?",
      "failurePatterns": [
        "\\berror\\b",
        "\\bfail(ed|ure|ing)?\\b",
        "\\bexception\\b",
        "\\bfatal\\b",
        "✗",
        "exit code [1-9]",
        "GATE ROJO"
      ],
      "$ignorePatterns": "Un caso VERDE del self-test cuyo nombre dice «gate rojo» o «error» casa `failurePatterns` sin ser el fallo: la primera corrida real llenaba el reporte de líneas `✓`.",
      "ignorePatterns": [
        "^\\s*✓"
      ],
      "contextLines": 2,
      "maxLines": 40,
      "timeoutMs": 60000
    }
  },
  "coherence": {
    "guides": [
      "CLAUDE.md",
      ".claude/commands",
      ".claude/skills",
      ".claude/agents"
    ],
    "commandPattern": "^(git|npm|npx|node|sh|gh|codegraph|find|curl|rm)\\s",
    "configKeys": [
      "reason",
      "message",
      "staleReason"
    ],
    "reason": "a guide recommending what a guard forbids leaves the agent in a retry loop."
  },
  "panel": {
    "out": ".git/harness-panel",
    "sources": {
      "guide": "CLAUDE.md",
      "constitutions": [
        "CONSTITUTION.md"
      ],
      "mechanismMarker": "*Mechanism:*",
      "manifest": "package.json"
    },
    "memory": {
      "decisionsDir": "docs/decisions",
      "runSessionHooks": true,
      "promptSources": [
        {
          "hook": "sdd-router",
          "key": "sdd.routes"
        }
      ]
    },
    "tasks": {
      "manifest": "package.json",
      "key": "scripts",
      "invocation": "npm run"
    }
  },
  "taxonomy": {
    "stages": [
      "sesión",
      "pedido",
      "acción decidida",
      "edición hecha",
      "fin del turno",
      "commit",
      "push",
      "integración",
      "continuo"
    ],
    "events": {
      "SessionStart": {
        "direction": "guía",
        "stage": "sesión"
      },
      "UserPromptSubmit": {
        "direction": "guía",
        "stage": "pedido"
      },
      "PreToolUse": {
        "direction": "freno",
        "stage": "acción decidida"
      },
      "PostToolUse": {
        "direction": "sensor",
        "stage": "edición hecha"
      },
      "Stop": {
        "direction": "sensor",
        "stage": "fin del turno"
      },
      "SubagentStop": {
        "direction": "sensor",
        "stage": "fin del turno"
      }
    },
    "gitHooksDir": ".githooks",
    "gitHooks": {
      "pre-commit": {
        "direction": "sensor",
        "stage": "commit"
      },
      "commit-msg": {
        "direction": "sensor",
        "stage": "commit"
      },
      "post-commit": {
        "direction": "guía",
        "stage": "commit"
      },
      "pre-push": {
        "direction": "sensor",
        "stage": "push"
      }
    },
    "gateStages": [
      "fin del turno",
      "integración"
    ],
    "agents": {
      "explorer": {
        "direction": "guía",
        "kind": "inferencial",
        "stage": "pedido"
      },
      "reviewer": {
        "direction": "sensor",
        "kind": "inferencial",
        "stage": "fin del turno"
      },
      "gate-runner": {
        "direction": "sensor",
        "kind": "computacional",
        "stage": "fin del turno"
      },
      "ci-investigator": {
        "direction": "sensor",
        "kind": "inferencial",
        "stage": "integración"
      }
    },
    "guides": {
      "CLAUDE.md": {
        "stage": "sesión"
      },
      "CONSTITUTION.md": {
        "stage": "sesión"
      },
      ".claude/commands": {
        "stage": "pedido"
      },
      ".claude/skills": {
        "stage": "pedido"
      }
    },
    "pipelines": {
      ".github/workflows/ci.yml": {
        "stage": "integración"
      },
      ".github/workflows/drift.yml": {
        "stage": "continuo"
      }
    }
  },
  "drift": {
    "statusDatePattern": "Last full gate:\\W*(\\d{4}-\\d{2}-\\d{2})",
    "statusMaxAgeDays": 14,
    "historyCommits": 400,
    "runner": ".github/workflows/drift.yml"
  },
  "install": {
    "activators": {
      ".claude/hooks/protected-paths.mjs": "protectedPaths",
      ".claude/hooks/bash-guard.mjs": "bash.deny",
      ".claude/hooks/reuse-guard.mjs": "reuse",
      ".claude/hooks/post-edit-check.mjs": "lint.command",
      ".claude/hooks/gate-stop.mjs": "gate.marker",
      ".claude/hooks/subagent-contract.mjs": "subagentOutput.contracts",
      ".claude/hooks/session-start.mjs": "status.file",
      ".claude/hooks/sdd-router.mjs": "sdd.routes",
      ".claude/hooks/graph-first.mjs": "graph.graphFile",
      ".claude/hooks/ask-first.mjs": "askFirst.marker",
      ".claude/hooks/action-guard.mjs": "askFirst.marker",
      ".githooks/commit-msg": "commitMsg.codePattern",
      ".githooks/pre-push": "branches.protected",
      "scripts/cycle-check.mjs": "workflow.branchPattern",
      "scripts/hooks-timing.mjs": "observability.budgetMs",
      "scripts/harness-map.mjs": "taxonomy",
      "scripts/drift-check.mjs": "drift",
      "scripts/ci-investigate.mjs": "ci.investigate.listCommand"
    }
  }
}
